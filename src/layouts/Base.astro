---
import { getMenuWithCacheHint, getSiteSettingsWithCacheHint } from "emdash";
import { EmDashBodyEnd, EmDashBodyStart, EmDashHead } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import SiteFooter from "../components/SiteFooter.astro";
import ThemePreflight from "../components/ThemePreflight.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	content,
} = Astro.props;
const [settingsResult, menuResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
]);
const settings = settingsResult.data;
const menu = menuResult.data;
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
}

const siteTitle = settings?.title || "Studio";
const separator = settings?.seo?.titleSeparator || " — ";
const fullTitle = !title
	? siteTitle
	: title === siteTitle ||
		  title.endsWith(` — ${siteTitle}`) ||
		  title.endsWith(` | ${siteTitle}`)
		? title
		: `${title}${separator}${siteTitle}`;
const siteDescription = settings?.tagline || "Design & Development";
const siteLogo = settings?.logo?.url ? settings.logo : null;
const canonicalUrl =
	canonical ?? new URL(Astro.url.pathname, Astro.url.origin).href;

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title ?? siteTitle,
	description: description || siteDescription,
	canonical: canonicalUrl,
	image,
	content,
	seo: { ogImage: image, robots },
	siteName: siteTitle,
});

const isLoggedIn = Boolean(Astro.locals.user);
// The menu's last item is drawn as the header's call to action, the pill the home page ends its navigation with.
const menuItems = menu?.items ?? [];
const path = Astro.url.pathname;
const isCurrent = (url: string) =>
	url !== "/" && (path === url || path.startsWith(`${url}/`));
---

<!doctype html>
<html lang="en" class="scheme-light motion-safe:scroll-smooth dark:scheme-dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Nunito:wght@400..800&display=swap"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title={`${siteTitle} RSS Feed`}
			href="/rss.xml"
		/>
		<ThemePreflight />
	</head>
	<body class="relative isolate min-h-screen text-base leading-normal">
		<EmDashBodyStart page={pageCtx} />
		<div class="page-sky" aria-hidden="true">
			<div class="sun"></div>
			<div class="cloud"></div>
		</div>
		<header>
			<nav
				class="wrap flex min-h-20 items-center justify-between gap-6 max-md:min-h-17"
				aria-label="Primary"
			>
				<a href="/" class="mark max-md:text-mark-sm">
					{
						siteLogo ? (
							<img
								src={siteLogo.url}
								alt={siteLogo.alt || siteTitle}
								class="-my-2 h-12 w-auto"
							/>
						) : (
							<>
								{siteTitle}
								<i aria-hidden="true">.</i>
							</>
						)
					}
				</a>
				<div
					class="flex flex-wrap items-center justify-end gap-x-7 gap-y-2 text-sm font-semibold max-md:gap-x-4.5"
				>
					{
						menuItems.map((item, index) => (
							<a
								href={item.url}
								target={item.target}
								rel={
									item.target === "_blank" ? "noopener noreferrer" : undefined
								}
								class:list={[
									"empty:hidden",
									index === menuItems.length - 1
										? "pill pill-dark"
										: ["nav-link", { underline: isCurrent(item.url) }],
								]}
								aria-current={isCurrent(item.url) ? "page" : undefined}
							>
								{item.label}
							</a>
						))
					}
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-link opacity-50">
								Admin
							</a>
						)
					}
				</div>
			</nav>
		</header>

		<main class="min-h-main">
			<slot />
		</main>

		<SiteFooter />
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
