---
import { getEmDashEntry, getSeoMeta } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";

const {
	entry: page,
	error,
	cacheHint,
} = await getEmDashEntry("pages", "about");
if (error) return new Response("Could not load the page", { status: 500 });
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const seo = getSeoMeta(page, {
	siteUrl: Astro.url.origin,
	path: "/about",
	defaultDescription: "Learn more about who we are and what we do.",
});

// Sample wording: replace it with your studio's own.
const sample = {
	makes: [
		"Illustrated sites",
		"Builds on EmDash",
		"Every page checked on a phone",
		"A record of who did what",
	],
	email: "hello@thepinies.example",
};
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	content={{ collection: "pages", id: page.data.id, slug: "about" }}
>
	<div
		class="wrap grid grid-cols-sidebar grid-rows-sidebar gap-x-24 gap-y-12 py-16 max-md:grid-cols-1 max-md:pt-12"
	>
		<header class="col-span-full">
			<h1 class="text-title max-md:text-title-sm" {...page.edit.title}>
				{page.data.title}
			</h1>
		</header>

		<div class="prose-record prose-lead" {...page.edit.content}>
			{
				page.data.content ? (
					<PortableText value={page.data.content} />
				) : (
					<p>Content coming soon.</p>
				)
			}
		</div>

		<aside class="sticky top-8 grid gap-5 self-start max-md:static">
			<div class="tile">
				<h3 class="mb-2 text-xl">What we make</h3>
				<ul class="text-md text-neutral-500 dark:text-neutral-300">
					{sample.makes.map((item) => <li class="mb-1">{item}</li>)}
				</ul>
			</div>

			<div class="tile">
				<h3 class="mb-2 text-xl">Contact</h3>
				<p class="mb-1 text-md text-neutral-500 dark:text-neutral-300">
					<a class="sidebar-link" href={`mailto:${sample.email}`}>{sample.email}</a>
				</p>
				<p class="mb-1 text-md text-neutral-500 dark:text-neutral-300">
					<a class="sidebar-link" href="/contact">Send us a message →</a>
				</p>
			</div>
		</aside>
	</div>
</Base>
