---
export const prerender = false;

import {
	getEmDashCollection,
	getTaxonomyTermsWithCacheHint,
	getTermsForEntries,
} from "emdash";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

// Get filter from query param. When set, push the filter down to the
// database via `where` instead of loading every project and filtering
// in JS — that pattern scales O(projects × terms-per-project) and
// blows up the moment you have more than a couple of dozen entries.
const activeTag = Astro.url.searchParams.get("tag");
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

const [projectsResult, tagsResult] = await Promise.all([
	getEmDashCollection("projects", {
		orderBy: { published_at: "desc" },
		limit: 12,
		cursor,
		...(activeTag ? { where: { tag: activeTag } } : {}),
	}),
	getTaxonomyTermsWithCacheHint("tag", { includeCounts: false }),
]);
if (projectsResult.error) {
	return new Response("Could not load the portfolio", { status: 500 });
}

const { entries: sortedProjects, nextCursor } = projectsResult;
const tags = tagsResult.data;
if (Astro.cache?.enabled) {
	Astro.cache.set(projectsResult.cacheHint);
	Astro.cache.set(tagsResult.cacheHint);
}

// Single batched JOIN for the tag pills shown on each card, instead of
// one getEntryTerms() round-trip per card.
const tagsByEntry = await getTermsForEntries(
	"projects",
	sortedProjects.map((p) => p.data.id),
	"tag",
);
const projectsWithTags = sortedProjects.map((project) => ({
	project,
	projectTags: tagsByEntry.get(project.data.id) ?? [],
}));

function workUrl(next: string): string {
	const params = new URLSearchParams({ cursor: next });
	if (activeTag) params.set("tag", activeTag);
	return `/work?${params.toString()}`;
}
---

<Base
	title={activeTag
		? `${tags.find((t) => t.slug === activeTag)?.label || activeTag} — Work`
		: "Work"}
>
	<section class="wrap pt-16 pb-8 max-md:pt-12">
		<div
			class="flex items-end justify-between gap-10 max-md:flex-col max-md:items-start max-md:gap-3"
		>
			<h1 class="text-title tracking-tight max-md:text-title-sm">Work</h1>
			<!-- Sample wording: replace it with your studio's own. -->
			<p
				class="max-w-intro text-intro leading-normal text-neutral-500 dark:text-neutral-300"
			>
				Real sites in production, on EmDash, kept up by people. Open one to see
				its record.
			</p>
		</div>

		{
			tags.length > 0 && (
				<nav class="mt-8 flex flex-wrap gap-2.5" aria-label="Filter by tag">
					{tags.map((tag) => (
						<a
							href={`/work?tag=${tag.slug}`}
							class:list={["tag-pill", { "tag-pill-active": activeTag === tag.slug }]}
							aria-current={activeTag === tag.slug ? "page" : undefined}
						>
							{tag.label}
						</a>
					))}
					{activeTag && (
						<a href="/work" class="tag-pill tag-pill-clear" aria-label="Clear filter">
							<span class="text-glyph" aria-hidden="true">×</span>
							Clear
						</a>
					)}
				</nav>
			)
		}
	</section>

	{
		projectsWithTags.length > 0 ? (
			<section class="wrap pt-4 pb-16">
				<div class="grid grid-cols-2 gap-7 max-md:grid-cols-1">
					{projectsWithTags.map(({ project, projectTags }, index) => (
						<ProjectCard
							title={project.data.title}
							summary={project.data.summary}
							featuredImage={project.data.featured_image}
							href={`/work/${project.id}`}
							client={project.data.client}
							year={project.data.year}
							tags={projectTags.map((t) => t.label)}
							edit={project.edit}
							number={cursor ? undefined : index + 1}
						/>
					))}
				</div>
			</section>
		) : (
			<section class="wrap mb-16 py-16 text-center text-intro text-neutral-500 dark:text-neutral-300">
				{activeTag ? (
					<>
						<p>No projects found with this tag.</p>
						<a href="/work" class="pill pill-dark mt-6">
							View all projects
						</a>
					</>
				) : (
					<>
						<p>No projects yet. Add your first project in the admin panel.</p>
						<a href="/_emdash/admin/content/projects/new" class="pill pill-dark mt-6">
							Add a project
						</a>
					</>
				)}
			</section>
		)
	}

	{
		nextCursor && (
			<nav class="wrap mb-16 text-center" aria-label="Portfolio pagination">
				<a href={workUrl(nextCursor)} rel="next" class="pill pill-outline">
					More projects
				</a>
			</nav>
		)
	}
</Base>
