---
import {
	decodeSlug,
	getEmDashCollection,
	getEmDashEntry,
	getSeoMeta,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const {
	entry: project,
	error,
	cacheHint: projectCacheHint,
} = await getEmDashEntry("projects", slug);

if (error) return new Response("Could not load the project", { status: 500 });
if (!project) {
	return Astro.rewrite("/404");
}

// Related projects: order by date in the DB and request a small lookahead
// so we can drop the current entry without re-querying. Avoids loading
// every project just to slice off two.
const relatedResult = await getEmDashCollection("projects", {
	orderBy: { published_at: "desc" },
	limit: 3,
});
if (relatedResult.error) {
	return new Response("Could not load related projects", { status: 500 });
}
const { entries: relatedProjects, cacheHint: relatedCacheHint } = relatedResult;
const otherProjects = relatedProjects
	.filter((p) => p.id !== project.id)
	.slice(0, 2);
if (Astro.cache?.enabled) {
	Astro.cache.set(projectCacheHint);
	Astro.cache.set(relatedCacheHint);
}

const gallery = project.data.gallery;

function safeExternalUrl(value: string | undefined): string | undefined {
	if (!value) return undefined;
	try {
		const url = new URL(value);
		return url.protocol === "https:" || url.protocol === "http:"
			? url.href
			: undefined;
	} catch {
		return undefined;
	}
}

const projectUrl = safeExternalUrl(project.data.url);
const seo = getSeoMeta(project, {
	siteUrl: Astro.url.origin,
	path: `/work/${slug}`,
	defaultDescription: project.data.summary,
	defaultOgImage: project.data.featured_image?.src,
});
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	content={{ collection: "projects", id: project.data.id, slug }}
>
	<article class="mx-auto max-w-record px-gutter py-16 max-md:pt-12">
		<header class="mb-12 max-w-heading">
			<div class="kind-line mb-2">
				{
					project.data.client && (
						<span {...project.edit.client}>{project.data.client}</span>
					)
				}
				{project.data.client && project.data.year && <span class="mx-1">·</span>}
				{
					project.data.year && (
						<span {...project.edit.year}>{project.data.year}</span>
					)
				}
			</div>
			<h1 class="mb-6 text-title max-md:text-title-sm" {...project.edit.title}>
				{project.data.title}
			</h1>
			{
				project.data.summary && (
					<p
						class="mb-6 max-w-lede text-lg leading-normal text-neutral-500 dark:text-neutral-300"
						{...project.edit.summary}
					>
						{project.data.summary}
					</p>
				)
			}
			{
				projectUrl && (
					<a
						href={projectUrl}
						class="pill pill-dark"
						target="_blank"
						rel="noopener noreferrer"
						{...project.edit.url}
					>
						View Live Project →
					</a>
				)
			}
		</header>

		{
			project.data.featured_image && (
				<div
					class="mb-16 overflow-hidden rounded-card border border-neutral-200 bg-white shadow-picture dark:border-neutral-700 dark:bg-neutral-800"
					{...project.edit.featured_image}
				>
					<Image image={project.data.featured_image} class="h-auto w-full max-w-none" />
				</div>
			)
		}

		<div class="prose-record" {...project.edit.content}>
			<PortableText value={project.data.content} />
		</div>

		{
			gallery && gallery.length > 0 && (
				<div
					class="mt-16 grid grid-cols-2 gap-7 max-md:grid-cols-1"
					{...project.edit.gallery}
				>
					{gallery.map((item) => (
						<figure>
							<Image
								image={item.image}
								class="h-auto w-full rounded-soft border border-neutral-200 dark:border-neutral-700"
							/>
							{item.caption && (
								<figcaption class="mt-2 text-sm font-semibold text-neutral-500 dark:text-neutral-300">
									{item.caption}
								</figcaption>
							)}
						</figure>
					))}
				</div>
			)
		}
	</article>

	{
		otherProjects.length > 0 && (
			<section class="border-t-2 border-dashed border-neutral-200 pt-16 pb-8 dark:border-neutral-700">
				<div class="wrap">
					<h2 class="mb-8 text-title-sm leading-tight tracking-tight max-md:text-heading">
						More work
					</h2>
					<div class="grid grid-cols-2 gap-7 max-md:grid-cols-1">
						{otherProjects.map((p) => (
							<ProjectCard
								title={p.data.title}
								summary={p.data.summary}
								featuredImage={p.data.featured_image}
								href={`/work/${p.id}`}
								client={p.data.client}
								year={p.data.year}
								edit={p.edit}
							/>
						))}
					</div>
				</div>
			</section>
		)
	}
</Base>
