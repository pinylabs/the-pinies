---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Pinies — a studio that makes real sites</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Nunito:wght@400..800&display=swap">
<style is:global>
/* The motion every site shares. Only transform and opacity move, so it stays on the compositor at 60 fps. Under
   prefers-reduced-motion everything is still, and a browser without scroll timelines simply shows the page. */

/* Page changes: the browser's cross-document view transition, as Astro's view transitions give it. A picture that
   names itself the same on both pages grows into its place; the rest fades and slides. */
@view-transition { navigation: auto; }
::view-transition-old(root) { animation: 260ms cubic-bezier(.4, 0, 1, 1) both vt-out; }
::view-transition-new(root) { animation: 420ms cubic-bezier(0, 0, .2, 1) 80ms both vt-in; }
::view-transition-group(*) { animation-duration: 520ms; animation-timing-function: cubic-bezier(.2, .8, .2, 1); }
@keyframes vt-out { to { opacity: 0; transform: translateY(-12px); } }
@keyframes vt-in { from { opacity: 0; transform: translateY(24px); } }

/* The hero's first moment: its words rise one line after another. */
.rise { animation: rise .9s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i, 0) * 110ms + 120ms); }
@keyframes rise { from { opacity: 0; transform: translateY(36px); } }

/* Scroll-driven: reveals move with `translate` and `scale`, so a card's hover `transform` still applies.
   The hero's photo drifts slower than the page, and its words lift away. */
@supports (animation-timeline: scroll()) {
  .parallax { animation: parallax linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
  .lift { animation: lift linear both; animation-timeline: scroll(root); animation-range: 0 70vh; }
  .reveal { animation: reveal linear both; animation-timeline: view(); animation-range: entry 0% entry 70%; }
  .reveal-side { animation: reveal-side linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
  .zoom-in { animation: zoom-in linear both; animation-timeline: view(); animation-range: entry 0% cover 50%; }
}
@keyframes parallax { from { transform: translateY(0) scale(1.08); } to { transform: translateY(22%) scale(1.16); } }
@keyframes lift { to { opacity: 0; transform: translateY(-90px); } }
@keyframes reveal { from { opacity: 0; translate: 0 70px; scale: .97; } }
@keyframes reveal-side { from { opacity: 0; translate: -60px 0; } }
@keyframes zoom-in { from { transform: scale(1.25); } }

/* Hover, for a site that takes it: a card lifts and its photo leans in. Each site adds its own signature beside it. */
.lift-card { transition: transform .45s cubic-bezier(.2, .8, .2, 1), box-shadow .45s; }
.lift-card .pic img { transition: transform .9s cubic-bezier(.2, .8, .2, 1); }
.lift-card:hover { transform: translateY(-8px); }
.lift-card:hover .pic img { transform: scale(1.07); }
.button { transition: transform .25s cubic-bezier(.2, .8, .2, 1), background-color .25s; }
.button:hover { transform: translateY(-2px); }

/* Calm: opacity only, for a site whose signature is stillness. */
@supports (animation-timeline: view()) {
  .fade { animation: fade linear both; animation-timeline: view(); animation-range: entry 0% entry 90%; }
}
@keyframes fade { from { opacity: 0; } }

/* The Pinies' entrances, the public site's four, played once when their row comes into view. */
.pinies[data-entrance] .face { animation-duration: .9s; animation-fill-mode: both; animation-delay: calc(var(--i) * .14s); animation-timing-function: cubic-bezier(.3, .7, .3, 1); }
.pinies[data-entrance='walk'] .face { animation-name: walk; }
.pinies[data-entrance='skid'] .face { animation-name: skid; }
.pinies[data-entrance='drop'] .face { animation-name: drop; animation-timing-function: ease-in; }
.pinies[data-entrance='peek'] .face { animation-name: peek; }
.pinies[data-entrance='peek'] .face:last-child { animation-name: peek, wave; animation-duration: .9s, .6s; animation-delay: calc(4 * .14s), 1.5s; animation-fill-mode: both, none; }
.pinies:not([data-entrance]):not([data-shown]) .face { opacity: 0; }
@keyframes walk {
  0% { transform: translateX(-120px); opacity: 0; } 12% { opacity: 1; }
  20% { transform: translateX(-96px) translateY(-4px); } 35% { transform: translateX(-70px) translateY(0); }
  50% { transform: translateX(-44px) translateY(-4px); } 65% { transform: translateX(-16px) translateY(0); }
  80% { transform: translateX(0) translateY(-16px); } 100% { transform: translateX(0) translateY(0); }
}
@keyframes skid {
  0% { transform: translateX(520px) rotate(0); opacity: 0; } 15% { opacity: 1; }
  65% { transform: translateX(-8px) rotate(-12deg); } 82% { transform: translateX(3px) rotate(3deg); } 100% { transform: translateX(0) rotate(0); }
}
@keyframes drop {
  0% { transform: translateY(-120px); opacity: 0; } 15% { opacity: 1; }
  60% { transform: translateY(0); } 75% { transform: translateY(-12px); } 90% { transform: translateY(0); } 95% { transform: translateY(-3px); } 100% { transform: translateY(0); }
}
@keyframes peek { 0% { transform: translateY(56px); opacity: 0; } 20% { opacity: 1; } 70% { transform: translateY(-5px); } 100% { transform: translateY(0); } }
@keyframes wave { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(-12deg); } 50% { transform: rotate(10deg); } 75% { transform: rotate(-6deg); } }

/* Still: reduced motion, and the stills this mock renders. */
@media (prefers-reduced-motion: reduce) {
  @view-transition { navigation: none; }
  *, *::before, *::after { animation: none !important; transition: none !important; }
  .pinies .face { opacity: 1 !important; }
}
html.still *, html.still *::before, html.still *::after { animation: none !important; transition: none !important; }
html.still .pinies .face { opacity: 1 !important; }
</style>
<style is:global>
:root {
  --bg: #fff7ec; --ink: #17131f; --soft: #5e5768; --card: #ffffff; --line: #eadfce;
  --sky1: #bfe8ef; --sky2: #ffe2b8; --sun: #ffb648; --hill1: #9fd6b9; --hill2: #5fb592; --hill3: #2f8a6f; --path: #f5d9a8;
  --purple: #7d73d9; --coral: #ef7b62; --teal: #0a6f7b;
  --display: 'Fredoka', system-ui, sans-serif; --sans: 'Nunito', system-ui, sans-serif;
}
@media (prefers-color-scheme: dark) {
  :root { --bg: #120f1a; --ink: #f4effa; --soft: #aaa2b6; --card: #1c1826; --line: #2c2639;
    --sky1: #1d1b3d; --sky2: #4a2d52; --sun: #ffd38a; --hill1: #2b4f53; --hill2: #1f3d40; --hill3: #142b2d; --path: #4a3d2c; --teal: #5cc8d4; }
}
* { box-sizing: border-box; margin: 0; }
html { background: var(--bg); }
body { background: var(--bg); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; overflow-x: clip; }
a { color: inherit; text-decoration: none; }
.wrap { max-width: 1280px; margin: 0 auto; padding: 0 40px; }
header { position: absolute; inset: 0 0 auto; z-index: 5; }
header .wrap { display: flex; align-items: center; justify-content: space-between; height: 80px; }
.mark { font-family: var(--display); font-weight: 700; font-size: 26px; letter-spacing: -.03em; }
.mark i { font-style: normal; color: var(--coral); }
nav { display: flex; gap: 28px; font-size: 15px; font-weight: 600; align-items: center; }
nav .button { background: var(--ink); color: var(--bg); padding: 10px 18px; border-radius: 999px; }
.scene { position: relative; height: 860px; overflow: hidden; background: linear-gradient(180deg, var(--sky1), var(--sky2) 70%); isolation: isolate; }
.scene .sun { position: absolute; width: 260px; height: 260px; border-radius: 50%; background: var(--sun); right: 14%; top: 120px; box-shadow: 0 0 120px 40px color-mix(in srgb, var(--sun) 45%, transparent); }
.scene .cloud { position: absolute; height: 46px; border-radius: 999px; background: rgba(255, 255, 255, .75); }
.scene .cloud::before, .scene .cloud::after { content: ''; position: absolute; border-radius: 50%; background: inherit; }
.scene .cloud::before { width: 60px; height: 60px; left: 22%; top: -28px; }
.scene .cloud::after { width: 44px; height: 44px; left: 52%; top: -18px; }
@media (prefers-color-scheme: dark) { .scene .cloud { background: rgba(255, 255, 255, .12); } }
.c1 { width: 180px; left: 64%; top: 330px; animation: drift 38s linear infinite; }
.c2 { width: 130px; left: 46%; top: 110px; animation: drift 52s linear infinite reverse; }
@keyframes drift { 50% { transform: translateX(80px); } }
.scene svg.hills { position: absolute; left: 0; width: 100%; height: auto; }
.far { bottom: 230px; } .mid { bottom: 120px; } .near { bottom: -2px; }
@supports (animation-timeline: scroll()) {
  .far { animation: p-far linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
  .mid { animation: p-mid linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
  .sun { animation: p-sun linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
}
@keyframes p-far { to { transform: translateY(120px); } }
@keyframes p-mid { to { transform: translateY(60px); } }
@keyframes p-sun { to { transform: translateY(220px) scale(.9); } }
.scene .words { position: absolute; left: 0; right: 0; top: 130px; }
.scene h1 { font-family: var(--display); font-weight: 700; font-size: 100px; line-height: .9; letter-spacing: -.025em; max-width: 900px; }
.scene h1 em { font-style: normal; color: var(--teal); }
.scene p { font-size: 21px; line-height: 1.5; max-width: 520px; margin-top: 20px; color: var(--soft); }
.scene .pinies { position: absolute; right: 7%; bottom: 70px; display: flex; gap: 14px; z-index: 2; }
.pinies .face { width: 120px; height: 120px; position: relative; }
.pinies .face svg { width: 100%; height: 100%; }
.pinies .face small { position: absolute; left: 50%; bottom: -24px; transform: translateX(-50%); font-weight: 700; font-size: 13px; color: var(--ink); background: var(--card); border-radius: 999px; padding: 2px 9px; }
.bubble { position: absolute; right: 9%; bottom: 230px; background: var(--card); color: var(--ink); border-radius: 22px; padding: 14px 18px; font-weight: 700; font-size: 17px; box-shadow: 0 14px 30px -18px rgba(0, 0, 0, .4); z-index: 2; animation: pop .6s cubic-bezier(.2, 1.6, .4, 1) 1.6s both; }
.bubble::after { content: ''; position: absolute; left: 24px; bottom: -10px; border: 10px solid transparent; border-top-color: var(--card); border-bottom: 0; }
@keyframes pop { from { opacity: 0; transform: scale(.6) translateY(20px); } }
.work { padding: 96px 0 64px; }
.work h2, .how h2 { font-family: var(--display); font-weight: 700; font-size: 76px; letter-spacing: -.02em; line-height: .95; }
.work .intro { display: flex; justify-content: space-between; align-items: end; margin-bottom: 36px; gap: 40px; }
.work .intro p { max-width: 420px; color: var(--soft); font-size: 18px; line-height: 1.5; }
.grid { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; }
.card { background: var(--card); border-radius: 30px; overflow: hidden; border: 1px solid var(--line); transition: transform .5s cubic-bezier(.3, 1.6, .5, 1), box-shadow .4s; }
.card:nth-child(odd):hover { transform: rotate(-2deg) translateY(-8px) scale(1.01); }
.card:nth-child(even):hover { transform: rotate(2deg) translateY(-8px) scale(1.01); }
.card .text { position: relative; border-top: 2px dashed var(--line); }
.card .text::before, .card .text::after { content: ''; position: absolute; top: -14px; width: 26px; height: 26px; border-radius: 50%; background: var(--bg); }
.card .text::before { left: -14px; } .card .text::after { right: -14px; }
.card .stub { position: absolute; right: 24px; top: 22px; font-family: var(--display); font-weight: 600; font-size: 13px; letter-spacing: .12em; color: var(--coral); border: 2px solid var(--coral); border-radius: 8px; padding: 3px 8px; transform: rotate(4deg); }
.scene .pinies .face, .how li .face { transition: transform .4s cubic-bezier(.3, 1.8, .5, 1); }
.scene .pinies .face:hover, .how li:hover .face { transform: translateY(-14px) rotate(-6deg); }
.how li { transition: transform .4s cubic-bezier(.3, 1.6, .5, 1); }
.how li:hover { transform: rotate(-1deg); }
.card:hover { box-shadow: 0 30px 70px -36px rgba(0, 0, 0, .45); }
.card .pic { aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--line); }
.card .pic img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
.card .text { padding: 22px 26px 26px; }
.card .kind { font-weight: 700; font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--teal); }
.card h3 { font-family: var(--display); font-weight: 700; font-size: 40px; letter-spacing: -.015em; margin: 4px 0 8px; }
.card p { color: var(--soft); font-size: 17px; line-height: 1.5; }
.card .record { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
.card .record span { background: var(--bg); border: 1px solid var(--line); border-radius: 999px; padding: 6px 12px; font-size: 13px; font-weight: 600; }
.how { padding: 32px 0 96px; }
.how ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-top: 32px; }
.how li { background: var(--card); border: 1px solid var(--line); border-radius: 26px; padding: 24px; }
.how li .face { width: 72px; height: 72px; display: block; margin-bottom: 10px; }
.how li .face svg { width: 100%; height: 100%; }
.how li b { font-family: var(--display); font-size: 24px; letter-spacing: -.02em; }
.how li p { color: var(--soft); font-size: 16px; line-height: 1.5; margin-top: 6px; }
@media (max-width: 767px) {
  .wrap { padding: 0 18px; }
  nav a:not(.button) { display: none; }
  .scene { height: 780px; }
  .scene .sun { width: 150px; height: 150px; top: 90px; right: 6%; }
  .scene .words { top: 110px; }
  .scene h1 { font-size: 60px; }
  .scene p { font-size: 17px; }
  .scene .pinies { gap: 2px; bottom: 60px; right: 50%; transform: translateX(50%); }
  .pinies .face { width: 68px; height: 68px; }
  .pinies .face small { font-size: 11px; bottom: -18px; padding: 1px 6px; }
  .bubble { left: auto; right: 18px; bottom: 170px; font-size: 15px; }
  .work { padding: 56px 0 40px; }
  .work h2, .how h2 { font-size: 48px; }
  .work .intro { flex-direction: column; align-items: start; gap: 12px; }
  .grid { grid-template-columns: 1fr; }
  .card h3 { font-size: 32px; }
  .how ol { grid-template-columns: 1fr; }
}
.still-card { height: 100%; display: grid; place-items: center; background: linear-gradient(135deg, var(--sky1, #bfe8ef), var(--sky2, #ffe2b8)); font-family: var(--display); font-weight: 700; font-size: 34px; color: var(--ink); }
</style>
</head>
<body>
<header><div class="wrap">
  <a class="mark" href="/">the pinies<i>.</i></a>
  <nav><a href="#">Work</a><a href="#">How we work</a><a href="#">The team</a><a class="button" href="#">Work with us in Piny</a></nav>
</div></header>
<section class="scene">
  <div class="sun"></div><div class="cloud c1"></div><div class="cloud c2"></div>
  <svg class="hills far" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 200 C200 120 380 150 560 190 S900 90 1100 150 S1340 210 1440 170 V320 H0Z" fill="var(--hill1)"/></svg>
  <svg class="hills mid" viewBox="0 0 1440 300" preserveAspectRatio="none"><path d="M0 170 C240 90 420 210 700 160 S1120 60 1440 150 V300 H0Z" fill="var(--hill2)"/></svg>
  <svg class="hills near" viewBox="0 0 1440 240" preserveAspectRatio="none"><path d="M0 120 C300 40 560 140 820 90 S1240 30 1440 100 V240 H0Z" fill="var(--hill3)"/><path d="M640 240 C700 180 760 150 860 120" stroke="var(--path)" stroke-width="26" fill="none" stroke-linecap="round"/></svg>
  <div class="wrap words lift">
    <h1><span class="rise" style="--i:0;display:block">Five Pinies.</span><span class="rise" style="--i:1;display:block"><em>Real sites,</em> and</span><span class="rise" style="--i:2;display:block">how we made them.</span></h1>
    <p class="rise" style="--i:3">A design and build team that lives in Piny. Every site here comes with its brief, who did what, the model we ran on, and what a person did by hand.</p>
  </div>
