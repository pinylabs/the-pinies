---
// The preview home, from its accepted design. The full template is being built by the Pinies;
// until then this page is the theme's home and the rest of the site is EmDash's own template.
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import ThemePreflight from "../components/ThemePreflight.astro";

// The home's own column: 40px a side on a desktop and 18px on a phone.
const wrap = "mx-auto max-w-page px-10 max-md:px-4.5";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The Pinies — a studio that makes real sites</title>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400..700&family=Nunito:wght@400..800&display=swap">
<ThemePreflight />
</head>
<body class="leading-natural">
<header class="absolute inset-x-0 top-0 z-5"><div class:list={[wrap, "flex h-20 items-center justify-between"]}>
  <a class="mark" href="/">the pinies<i>.</i></a>
  <nav class="flex items-center gap-7 text-sm font-semibold"><a class="max-md:hidden" href="#">Work</a><a class="max-md:hidden" href="#">How we work</a><a class="max-md:hidden" href="#">The team</a><a class="pill pill-dark" href="#">Work with us in Piny</a></nav>
</div></header>
<section class="scene">
  <div class="sun"></div><div class="cloud c1"></div><div class="cloud c2"></div>
  <svg class="hills far" viewBox="0 0 1440 320" preserveAspectRatio="none"><path d="M0 200 C200 120 380 150 560 190 S900 90 1100 150 S1340 210 1440 170 V320 H0Z" class="fill-secondary-200 dark:fill-secondary-800"/></svg>
  <svg class="hills mid" viewBox="0 0 1440 300" preserveAspectRatio="none"><path d="M0 170 C240 90 420 210 700 160 S1120 60 1440 150 V300 H0Z" class="fill-secondary-400 dark:fill-secondary-900"/></svg>
  <svg class="hills near" viewBox="0 0 1440 240" preserveAspectRatio="none"><path d="M0 120 C300 40 560 140 820 90 S1240 30 1440 100 V240 H0Z" class="fill-secondary-600 dark:fill-secondary-950"/><path d="M640 240 C700 180 760 150 860 120" stroke-width="26" fill="none" stroke-linecap="round" class="stroke-tertiary-100 dark:stroke-tertiary-800"/></svg>
  <div class:list={[wrap, "lift absolute inset-x-0 top-32.5 max-md:top-27.5"]}>
    <h1 class="max-w-hero text-hero max-md:text-hero-sm"><span class="rise block" style="--i:0">Five Pinies.</span><span class="rise block" style="--i:1"><em class="text-primary-700 not-italic dark:text-primary-300">Real sites,</em> and</span><span class="rise block" style="--i:2">how we made them.</span></h1>
    <p class="rise mt-5 max-w-hero-copy text-lg leading-normal text-neutral-500 max-md:text-base dark:text-neutral-300" style="--i:3">A design and build team that lives in Piny. Every site here comes with its brief, who did what, the model we ran on, and what a person did by hand.</p>
  </div>
  <div class="pinies" data-play="walk"><span class="face"><svg xmlns="http://www.w3.org/2000/svg" viewBox="-62 -62 124 124" aria-hidden="true" focusable="false"><g><path d="M-12,33 L-13,50" stroke="#7D73D9" stroke-width="4.6" stroke-linecap="round"/><ellipse cx="-15" cy="52" rx="6.5" ry="3.8" fill="#26215C" stroke="#7D73D9" stroke-width="2"/><path d="M12,33 L13,50" stroke="#7D73D9" stroke-width="4.6" stroke-linecap="round"/><ellipse cx="15" cy="52" rx="6.5" ry="3.8" fill="#26215C" stroke="#7D73D9" stroke-width="2"/><path d="M-27.309516212355263,17 Q-39.30951621235526,22 -41.30951621235526,31" stroke="#7D73D9" stroke-width="4.6" fill="none" stroke-linecap="round"/><path d="M27.309516212355263,17 Q35.15475810617763,20 33,27" stroke="#7D73D9" stroke-width="4.6" fill="none" stroke-linecap="round"/><path data-piny-part="outline" d="M0,-41 A41,41 0 1 1 0,41 A41,41 0 1 1 0,-41 Z" fill="#AFA9EC" stroke="#7D73D9" stroke-width="3.2" stroke-linejoin="round"/><ellipse cx="-20" cy="11" rx="5" ry="3" fill="#F06F8B" opacity=".28"/><ellipse cx="20" cy="11" rx="5" ry="3" fill="#F06F8B" opacity=".28"/></g><g><ellipse cx="-13" cy="-7" rx="7.5" ry="7.50" fill="#fff"/><circle cx="-11.5" cy="-6" r="3.80" fill="#2C2C2A"/><circle cx="-10.2" cy="-7.6" r="1.2" fill="#fff"/><ellipse cx="13" cy="-7" rx="7.5" ry="7.50" fill="#fff"/><circle cx="14.5" cy="-6" r="3.80" fill="#2C2C2A"/><circle cx="15.8" cy="-7.6" r="1.2" fill="#fff"/></g><g><path d="M-8.00,13 Q0,18.00 8.00,13" stroke="#26215C" stroke-width="2.8" fill="none" stroke-linecap="round"/></g><g><g class="piny-prop piny-prop-roadmap"><g transform="translate(34,14) rotate(8)"><rect x="0" y="0" width="30" height="23" rx="3" fill="#F7F5EE" stroke="#5F5E5A" stroke-width="1.6"/><path d="M5,18 C10,18 9,9 15,10 C21,11 22,5 25,5" stroke="#534AB7" stroke-width="2" fill="none" stroke-linecap="round"/><circle cx="5" cy="18" r="2" fill="#534AB7"/><circle cx="25" cy="5" r="2.4" fill="#E2533F"/></g></g><circle cx="-41.30951621235526" cy="31" r="4.6" fil