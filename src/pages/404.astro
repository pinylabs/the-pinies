---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<div class="mx-auto max-w-reading px-gutter py-16 text-center">
		<span
			class="mb-8 inline-block -rotate-4 rounded-stamp border-6 border-tertiary-500 px-7 pt-2 pb-3.5 font-display text-stamp font-bold text-tertiary-500 max-xs:px-4.5 max-xs:pt-1.5 max-xs:pb-2.5 max-xs:text-stamp-sm"
			>404</span
		>
		<h1 class="mb-4 text-title-sm tracking-tight">Page not found</h1>
		<p class="mb-8 text-intro text-neutral-500 dark:text-neutral-300">
			The page you're looking for doesn't exist or has been moved.
		</p>
		<div class="flex justify-center gap-4 max-xs:flex-col">
			<a href="/" class="pill pill-dark border-2 border-neutral-900 dark:border-neutral-100"
				>Go home</a
			>
			<a href="/work" class="pill pill-outline">View our work</a>
		</div>
	</div>
</Base>
