---
import Base from "../layouts/Base.astro";

// Sample wording: replace it with your studio's own address.
const contactEmail = "hello@thepinies.example";
---

<Base title="Contact" description="Get in touch about your next project.">
	<div class="wrap py-16 max-md:pt-12">
		<header class="mb-16 max-w-heading">
			<p class="kind-line mb-2">Start a conversation</p>
			<h1 class="mb-6 text-title max-md:text-title-sm">Tell us about your project</h1>
			<p class="max-w-lede text-lg leading-normal text-neutral-500 dark:text-neutral-300">
				Share what you are making, the problem you need to solve, and any timing
				you have in mind. We will reply by email.
			</p>
		</header>

		<section
			class="ticket-notched flex items-center justify-between gap-12 rounded-card border border-neutral-200 bg-white px-8.5 py-7.5 max-md:flex-col max-md:items-start max-md:gap-6 max-md:px-6.5 max-md:py-6 dark:border-neutral-700 dark:bg-neutral-800"
			aria-labelledby="contact-email-heading"
		>
			<div>
				<h2 id="contact-email-heading" class="mb-1 text-heading max-md:text-heading-sm">
					Email the studio
				</h2>
				<p class="text-base text-neutral-500 dark:text-neutral-300">
					Use your email app to send the project details directly.
				</p>
			</div>
			<a
				class="inline-flex items-center gap-2 rounded-pill bg-neutral-900 px-6 py-3.5 font-bold text-neutral-50 transition duration-250 ease-glide hover:-translate-y-0.5 hover:bg-primary-700 hover:text-white max-xs:w-full max-xs:justify-between max-xs:wrap-anywhere dark:bg-neutral-100 dark:text-neutral-950 dark:hover:bg-primary-300 dark:hover:text-neutral-950"
				href={`mailto:${contactEmail}`}
			>
				{contactEmail}
				<span aria-hidden="true">→</span>
			</a>
		</section>
	</div>
</Base>
