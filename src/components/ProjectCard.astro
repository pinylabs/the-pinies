---
import type { EditProxy, MediaValue } from "emdash";
import { Image } from "emdash/ui";

interface Props {
	title: string;
	summary?: string;
	featuredImage: MediaValue;
	href: string;
	client?: string;
	year?: string;
	tags?: string[];
	edit?: EditProxy;
	/** The card's place in its list, printed on the ticket stub as "SITE Nº 01". */
	number?: number;
}

const { title, summary, featuredImage, href, client, year, tags, edit, number } =
	Astro.props;
const allTags = tags || [];
const stub =
	number !== undefined
		? `SITE Nº ${String(number).padStart(2, "0")}`
		: year
			? `SITE · ${year}`
			: "SITE";
---

<article class="tilt relative flex">
	<a href={href} class="ticket flex w-full flex-col">
		<div class="ticket-pic" {...edit?.featured_image}>
			{
				featuredImage ? (
					<Image
						image={featuredImage}
						class="block size-full max-w-none object-cover object-top"
					/>
				) : (
					<div class="ticket-still">
						<span>{title}</span>
					</div>
				)
			}
		</div>
		<div class="ticket-tear flex-1">
			<span class="ticket-stub" aria-hidden="true">{stub}</span>
			{
				(client || year) && (
					<div class="kind-line pr-30">
						{client && <span {...edit?.client}>{client}</span>}
						{client && year && <span aria-hidden="true"> · </span>}
						{year && <span {...edit?.year}>{year}</span>}
					</div>
				)
			}
			<h2 class="mt-1 mb-2 text-heading max-md:text-heading-sm" {...edit?.title}>
				{title}
			</h2>
			{
				summary && (
					<p
						class="line-clamp-3 text-base leading-normal text-neutral-500 dark:text-neutral-300"
						{...edit?.summary}
					>
						{summary}
					</p>
				)
			}
			{
				allTags.length > 0 && (
					<div class="mt-3.5 flex flex-wrap gap-2.5">
						{allTags.map((tag) => (
							<span class="chip">{tag}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>
