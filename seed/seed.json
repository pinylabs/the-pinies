							"_key": "a2"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Sam draws it: the look, from your brief, on phone and desktop.",
									"_key": "a5"
								}
							],
							"_key": "a4"
						},
						{
							"_type": "block",
							"style": "normal",
							"children": [
								{
									"_type": "span",
									"text": "Ana and Kai build it, on EmDash, with the content in the seed.",
